<%-layout("/layouts/boilerplate.ejs")%>
<%=successMsg%>
    <h1 class="text-center my-4">
        All Listings
    </h1>
  

    <div class="row">
        <% listings.forEach(listing => { %>
            <div class="col-lg-4 col-md-6 col-12 mb-4">
                <div class="card h-100">
                    <img src="<%= listing.image %>" class="card-img-top" alt="listing image" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title"><%= listing.title %></h5>
                        <p class="card-text"><%= listing.price %>/night</p>
                        <form action="/home/<%= listing._id %>" method="GET" class="mt-auto">
                            <button type="submit" class="btn btn-outline-primary">See details</button>
                        </form>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
