<%- layout("/layouts/boilerplate")%>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0"><%= listing.title %></h1>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <img src="<%= listing.image %>" alt="Listing image" class="img-fluid rounded">
                        </div>
                        <div class="col-md-6">
                            <h5 class="card-title">Description</h5>
                            <p class="card-text"><%= listing.description %></p>
                            <h6 class="card-subtitle mb-2 text-muted">Price: <%= listing.price %></h6>
                            <p class="card-text"><strong>Location:</strong> <%= listing.location %></p>
                            <p class="card-text"><strong>Country:</strong> <%= listing.country %></p>
                        </div>
                    </div>
                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <%if(currentUser && currentUser._id.equals(listing.owner._id)){%>
                        <form action="/edit/<%= listing._id %>" method="GET" class="d-inline">
                            <button type="submit" class="btn btn-outline-primary btn-animated">Edit Listing</button>
                        </form>
                        <form action="/delete/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-animated" onclick="return confirm('Are you sure you want to delete this listing?')">Delete</button>
                        </form>
                        <%}%>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- reviews section -->
<section class="review-section mt-4">
    <div class="row gx-4 gy-4">
        <div class="col-lg-4">
            <div class="card shadow review-card review-form-card">
                <div class="card-body">
                    <h4 class="mb-3 text-white">Leave a review</h4>
                    <form action="/home/<%=listing._id%>/reviews" method="post" novalidate class="needs-validation review-form">
                        <div class="form-group">
                            <label for="rating" class="form-label">Rating</label>
                            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="comment" class="form-label">Comment</label>
                            <input type="text" id="comment" name="review[comment]" class="form-control" required>
                            <div class="valid-feedback">Looks good</div>
                            <div class="invalid-feedback">Please provide a valid input</div>
                        </div>
                        <div class="form-group form-group--full">
                            <button type="submit" class="btn btn-primary btn-animated review-submit">Send</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="reviews-list">
                <h4 class="mb-3">All Reviews</h4>
                <% if (listing.reviews.length === 0) { %>
                    <div class="card review-item review-empty">
                        <div class="card-body">
                            <p class="mb-0 text-muted">No reviews yet. Be the first to leave one.</p>
                        </div>
                    </div>
                <% } %>
                <% for (let review of listing.reviews) { %>
                    <div class="card mb-3 review-item">
                        <div class="card-body">
                            <div class="review-header mb-2">
                                <div class="review-stars" aria-label="Rating: <%= review.rating %> out of 5">
                                    <%= '★'.repeat(review.rating) %><%= '☆'.repeat(5 - review.rating) %>
                                </div>
                                <span class="review-badge"><%= review.rating %> / 5</span>
                            </div>
                            <p class="card-text mb-0"><%= review.comment %></p>
                        </div>
                    </div>
                    <form action="/home/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-animated" onclick="return confirm('Are you sure you want to delete this review?')">Delete</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>
</section>
